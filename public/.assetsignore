# Files wrangler must never upload as static assets (gitignore syntax). Vite
# copies this file into dist/client, where wrangler reads it. Never list
# .well-known/ here: security.txt stays public.
.git/
.vite/
.wrangler/
.DS_Store
.env*
.dev.vars
wrangler.json*
node_modules/
.github/
.gh-workflows/
justfile
README.md
