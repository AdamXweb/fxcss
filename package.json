{
  "name": "fxcss-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "wrangler deploy --config dist/server/wrangler.json --domain fxcss.com --domain www.fxcss.com",
    "lint": "oxlint app components hooks lib scripts tests proxy.ts next.config.ts vite.config.ts playwright.config.ts",
    "format": "oxfmt",
    "content": "node scripts/build-content.mjs",
    "predev": "npm run content",
    "prebuild": "npm run content",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:production": "node scripts/check-site.mjs",
    "check:audit": "node scripts/audit.mjs",
    "test:installer": "python3 tests/test_installer.py -v",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/workers-types": "5.20261006.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "marked": "18.0.11",
    "oxfmt": "0.72.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sanitize-html": "2.18.1",
    "shadcn": "4.22.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.4",
    "wrangler": "4.149.0"
  },
  "type": "module",
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    },
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
